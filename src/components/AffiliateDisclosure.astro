---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="flex items-start gap-3 bg-earth-50 border border-earth-200 rounded-xl px-5 py-4 text-sm text-moss-600">
  <svg class="w-5 h-5 text-earth-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
  </svg>
  <p>{text}</p>
</div>
